        { "type": "path", "url": "../marko/packages/filesystem-s3" },
        { "type": "path", "url": "../marko/packages/framework" },
        { "type": "path", "url": "../marko/packages/hashing" },
        { "type": "path", "url": "../marko/packages/health" },

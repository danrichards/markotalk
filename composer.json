{
    "name": "markotalk/app",
    "description": "MarkoTalk - A real-time community chat platform built with the Marko PHP framework",
    "type": "project",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": "^8.5",
        "marko/amphp": "dev-develop",
        "marko/authentication": "dev-develop",
        "marko/authentication-token": "dev-develop",
        "marko/authorization": "dev-develop",
        "marko/cache-array": "dev-develop",
        "marko/database": "dev-develop",
        "marko/database-pgsql": "dev-develop",
        "marko/dev-server": "dev-develop",
        "marko/encryption": "dev-develop",
        "marko/encryption-openssl": "dev-develop",
        "marko/env": "dev-develop",
        "marko/framework": "dev-develop",
        "marko/log": "dev-develop",
        "marko/log-file": "dev-develop",
        "marko/notification": "dev-develop",
        "marko/notification-database": "dev-develop",
        "marko/pagination": "dev-develop",
        "marko/pubsub": "dev-develop",
        "marko/pubsub-pgsql": "dev-develop",
        "marko/rate-limiting": "dev-develop",
        "marko/security": "dev-develop",
        "marko/session": "dev-develop",
        "marko/session-database": "dev-develop",
        "marko/sse": "dev-develop",
        "marko/testing": "dev-develop",
        "marko/view": "dev-develop",
        "marko/view-latte": "dev-develop"
    },
    "require-dev": {
        "pestphp/pest": "^4.3"
    },
    "autoload": {
        "psr-4": {
            "App\\Admin\\": "app/admin/src/",
            "App\\Landing\\": "app/landing/src/",
            "App\\Message\\": "app/message/src/",
            "App\\Notification\\": "app/notification/src/",
            "App\\Space\\": "app/space/src/",
            "App\\User\\": "app/user/src/",
            "App\\User\\Seed\\": "app/user/Seed/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "App\\Admin\\Tests\\": "app/admin/tests/",
            "App\\Landing\\Tests\\": "app/landing/tests/",
            "App\\Message\\Tests\\": "app/message/tests/",
            "App\\Notification\\Tests\\": "app/notification/tests/",
            "App\\Space\\Tests\\": "app/space/tests/",
            "App\\User\\Tests\\": "app/user/tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}

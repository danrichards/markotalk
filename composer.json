        "marko/session": "dev-develop as 0.1.0",
        "marko/sse": "dev-develop as 0.1.0",
        "marko/testing": "dev-develop as 0.1.0",
        "marko/validation": "dev-develop as 0.1.0",
        "marko/view": "dev-develop as 0.1.0",
        "marko/view-latte": "dev-develop as 0.1.0",
        "marko/session-database": "dev-develop as 0.1.0"
    },
    "require-dev": {
        "pestphp/pest": "^4.3"
    },
    "repositories": [
        { "type": "path", "url": "../marko/packages/admin" },
        { "type": "path", "url": "../marko/packages/admin-api" },
        { "type": "path", "url": "../marko/packages/admin-auth" },
        { "type": "path", "url": "../marko/packages/admin-panel" },

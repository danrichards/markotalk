        { "type": "path", "url": "../marko/packages/media" },
        { "type": "path", "url": "../marko/packages/media-gd" },
        { "type": "path", "url": "../marko/packages/media-imagick" },
        { "type": "path", "url": "../marko/packages/notification" },
        { "type": "path", "url": "../marko/packages/notification-database" },
        { "type": "path", "url": "../marko/packages/pagination" },
        { "type": "path", "url": "../marko/packages/queue" },
        { "type": "path", "url": "../marko/packages/queue-database" },
        { "type": "path", "url": "../marko/packages/queue-rabbitmq" },
        { "type": "path", "url": "../marko/packages/queue-sync" },
        { "type": "path", "url": "../marko/packages/rate-limiting" },
        { "type": "path", "url": "../marko/packages/routing" },
        { "type": "path", "url": "../marko/packages/scheduler" },
        { "type": "path", "url": "../marko/packages/search" },
        { "type": "path", "url": "../marko/packages/security" },
        { "type": "path", "url": "../marko/packages/session" },
        { "type": "path", "url": "../marko/packages/session-database" },
        { "type": "path", "url": "../marko/packages/session-file" },
        { "type": "path", "url": "../marko/packages/sse" },
        { "type": "path", "url": "../marko/packages/testing" },
        { "type": "path", "url": "../marko/packages/translation" },
        { "type": "path", "url": "../marko/packages/translation-file" },

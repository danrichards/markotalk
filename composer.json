        { "type": "path", "url": "../marko/packages/blog" },
        { "type": "path", "url": "../marko/packages/cache" },
        { "type": "path", "url": "../marko/packages/cache-array" },
        { "type": "path", "url": "../marko/packages/cache-file" },
        { "type": "path", "url": "../marko/packages/cache-redis" },
        { "type": "path", "url": "../marko/packages/cli" },
        { "type": "path", "url": "../marko/packages/config" },
        { "type": "path", "url": "../marko/packages/core" },
        { "type": "path", "url": "../marko/packages/cors" },
        { "type": "path", "url": "../marko/packages/database" },
        { "type": "path", "url": "../marko/packages/database-mysql" },
        { "type": "path", "url": "../marko/packages/database-pgsql" },
        { "type": "path", "url": "../marko/packages/dev-server" },

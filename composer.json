{
    "name": "markotalk/app",
    "description": "MarkoTalk - A real-time community chat platform built with the Marko PHP framework",
    "type": "project",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": "^8.5",
        "marko/authentication": "dev-develop as 0.1.0",
        "marko/authorization": "dev-develop as 0.1.0",
        "marko/cache-array": "dev-develop as 0.1.0",
        "marko/config": "dev-develop as 0.1.0",
        "marko/core": "dev-develop as 0.1.0",
        "marko/database": "dev-develop as 0.1.0",
        "marko/database-pgsql": "dev-develop as 0.1.0",
        "marko/dev-server": "dev-develop as 0.1.0",
        "marko/env": "dev-develop as 0.1.0",
        "marko/errors": "dev-develop as 0.1.0",
        "marko/errors-simple": "dev-develop as 0.1.0",
        "marko/hashing": "dev-develop as 0.1.0",
        "marko/log": "dev-develop as 0.1.0",
        "marko/log-file": "dev-develop as 0.1.0",
        "marko/notification": "dev-develop as 0.1.0",
        "marko/notification-database": "dev-develop as 0.1.0",

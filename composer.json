{
    "name": "markotalk/app",
    "description": "MarkoTalk - A real-time community chat platform built with the Marko PHP framework",
    "type": "project",
    "require": {
        "php": "^8.5",
        "marko/amphp": "^0.0.1",
        "marko/authentication": "^0.0.1",
        "marko/authentication-token": "^0.0.1",
        "marko/authorization": "^0.0.1",
        "marko/cache-array": "^0.0.1",
        "marko/database": "^0.0.1",
        "marko/database-pgsql": "^0.0.1",
        "marko/dev-server": "^0.0.1",
        "marko/encryption": "^0.0.1",
        "marko/encryption-openssl": "^0.0.1",
        "marko/env": "^0.0.1",
        "marko/framework": "^0.0.1",
        "marko/log": "^0.0.1",
        "marko/log-file": "^0.0.1",
        "marko/notification": "^0.0.1",
        "marko/notification-database": "^0.0.1",
        "marko/pagination": "^0.0.1",
        "marko/pubsub": "^0.0.1",
        "marko/pubsub-pgsql": "^0.0.1",
        "marko/rate-limiting": "^0.0.1",
        "marko/security": "^0.0.1",
        "marko/session": "^0.0.1",
        "marko/session-database": "^0.0.1",
        "marko/sse": "^0.0.1",
        "marko/testing": "^0.0.1",
        "marko/view": "^0.0.1",
        "marko/view-latte": "^0.0.1"
    },
    "require-dev": {
        "pestphp/pest": "^4.3"
    },
    "autoload": {
        "psr-4": {
            "App\\Admin\\": "app/admin/src/",
            "App\\Landing\\": "app/landing/src/",
            "App\\Message\\": "app/message/src/",
            "App\\Notification\\": "app/notification/src/",
            "App\\Space\\": "app/space/src/",
            "App\\User\\": "app/user/src/",
            "App\\User\\Seed\\": "app/user/Seed/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "App\\Admin\\Tests\\": "app/admin/tests/",
            "App\\Landing\\Tests\\": "app/landing/tests/",
            "App\\Message\\Tests\\": "app/message/tests/",
            "App\\Notification\\Tests\\": "app/notification/tests/",
            "App\\Space\\Tests\\": "app/space/tests/",
            "App\\User\\Tests\\": "app/user/tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}

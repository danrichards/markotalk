{extends "landing::layout"}

{block title}{$space->name} — MarkoTalk{/block}

{block sidebar}
  {* space list sidebar *}
  <nav class="space-list">
    {foreach $spaces as $navSpace}
    <a href="/spaces/{$navSpace->slug}" class="space-item{if $navSpace->slug === $space->slug} space-item-active{/if}">
      <span class="space-hash">#</span>
      <span class="space-name">{$navSpace->name}</span>
      {if isset($unreadCounts[$navSpace->id]) && $unreadCounts[$navSpace->id] > 0}
      <span class="space-item-unread">{$unreadCounts[$navSpace->id]}</span>
      {/if}
    </a>
    {/foreach}
  </nav>
  {* member list in sidebar *}
  <div class="member-section">
    <h3 class="member-section-title">Members</h3>
    <ul class="member-list" id="member-list">
      {if isset($currentUser)}
      <li class="member-item member-item-self" data-user-id="{$currentUser->id}">
        <span class="member-indicator is-online"></span>
        <span class="member-name">{$currentUser->displayName ?? $currentUser->username}</span>
      </li>
      {/if}
      {foreach $members as $member}
      {continueIf isset($currentUser) && $member->id === $currentUser->id}
      <li class="member-item" data-user-id="{$member->id}">
        <span class="member-indicator {if isset($onlineUserIds) && in_array($member->id, $onlineUserIds)}is-online{else}is-offline{/if}"></span>
        <span class="member-name">{$member->displayName ?? $member->username}</span>
      </li>
      {/foreach}
    </ul>
  </div>
{/block}

{block content}
<div class="chat-area">
  <div class="chat-header">
    <h2 class="chat-title"># {$space->name}</h2>
  </div>
  <div class="chat-feed" id="chat-feed" data-space-slug="{$space->slug}" data-current-user-id="{$currentUser->id}">
    {foreach $messages as $message}
      {include "message::_message", message: $message, currentUser: $currentUser, csrfToken: $csrfToken}
    {/foreach}
  </div>
  <div class="chat-input">
    <form class="chat-input-form" method="POST" action="/spaces/{$space->slug}/messages">
      <input type="hidden" name="_token" value="{$csrfToken}">
      <textarea class="chat-input-field" name="body" placeholder="Message #{$space->name}" rows="1" id="message-input"></textarea>
      <button class="chat-input-send" type="submit">Send</button>
    </form>
  </div>
</div>
{/block}

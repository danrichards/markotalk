{extends "layout"}

{block title}Login — MarkoTalk{/block}

{block content}
<div class="auth-container">
  <div class="auth-card">
    <h1 class="auth-title">Sign In</h1>
    <form class="auth-form" method="POST" action="/login">
      <input type="hidden" name="_token" value="{$csrfToken}">
      <div class="auth-field">
        <label class="auth-label" for="email">Email</label>
        <input class="auth-input{if isset($errors['email'])} auth-input-error{/if}" type="email" id="email" name="email" value="{$old['email'] ?? ''}">
        {if isset($errors['email'])}
        <span class="auth-error">{$errors['email']}</span>
        {/if}
      </div>
      <div class="auth-field">
        <label class="auth-label" for="password">Password</label>
        <input class="auth-input" type="password" id="password" name="password">
      </div>
      <button class="auth-submit" type="submit">Sign In</button>
    </form>
    <p class="auth-link">Don't have an account? <a href="/register">Register</a></p>
  </div>
</div>
{/block}

{layout 'landing::layout'}

{block title}Edit Profile{/block}

{block content}
<div class="profile-form">
    {if isset($success) && $success}
    <div class="profile-success">Profile updated successfully.</div>
    {/if}
    {if isset($errors) && $errors->isNotEmpty()}
    <div class="profile-errors">
        {foreach $errors->all() as $field => $messages}
        {foreach $messages as $message}
        <p class="profile-error-item">{$message}</p>
        {/foreach}
        {/foreach}
    </div>
    {/if}
    <form method="post" action="/profile" class="profile-form-inner">
        <div class="profile-avatar">
            {if $user->avatarUrl}
            <img src="{$user->avatarUrl}" alt="Avatar" class="profile-avatar-image">
            {/if}
        </div>
        <div class="profile-field">
            <label for="display_name" class="profile-label">Display Name</label>
            <input
                type="text"
                id="display_name"
                name="display_name"
                value="{$user->displayName}"
                maxlength="100"
                class="profile-input"
            >
        </div>
        <div class="profile-field">
            <label for="avatar_url" class="profile-label">Avatar URL</label>
            <input
                type="url"
                id="avatar_url"
                name="avatar_url"
                value="{$user->avatarUrl}"
                class="profile-input"
            >
        </div>
        <div class="profile-actions">
            <button type="submit" class="btn btn-primary">Save Changes</button>
        </div>
    </form>
</div>
{/block}

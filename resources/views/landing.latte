<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>MarkoTalk — Real-time community chat</title>
    <link rel="stylesheet" href="/css/app.css">
</head>
<body class="landing-body">
    <div class="landing-container">
        <div class="landing-hero">
            <h1 class="landing-title">MarkoTalk</h1>
            <p class="landing-tagline">Real-time community chat built with the Marko PHP framework</p>
            <div class="landing-cta">
                <a href="/login" class="landing-btn-primary">Sign In</a>
                <a href="/register" class="landing-btn-secondary">Create Account</a>
            </div>
        </div>
        <div class="landing-features">
            <div class="landing-feature">
                <h2 class="landing-feature-title">Real-time Messaging</h2>
                <p class="landing-feature-description">Instant message delivery via Server-Sent Events (SSE)</p>
            </div>
            <div class="landing-feature">
                <h2 class="landing-feature-title">Community Spaces</h2>
                <p class="landing-feature-description">Organize conversations into dedicated channels and spaces</p>
            </div>
            <div class="landing-feature">
                <h2 class="landing-feature-title">Built with Marko PHP</h2>
                <p class="landing-feature-description">Dogfooding the Marko PHP framework for its own developer community</p>
            </div>
        </div>
    </div>
</body>
</html>
